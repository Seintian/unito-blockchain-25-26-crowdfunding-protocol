# Sepolia RPC URL (Infura, Alchemy, or Public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer Private Key (Without 0x prefix or with 0x prefix)
# CAUTION: Never commit real private keys or use accounts with mainnet assets!
PRIVATE_KEY=your_private_key_here

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas reporting flag (true/false)
REPORT_GAS=false

# =====================================================================
# Frontend Web3 dApp Configuration (Vite client-exposed variables)
# =====================================================================

# Deployed CrowdfundingFactory contract address (used by frontend to discover and create campaigns)
VITE_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# Deployed Funding Token (e.g., Mock USDC) address for campaign pledges and testing
VITE_FUNDING_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Deployed Reward Token (e.g., Mock GOV) address for campaign rewards and collateral
VITE_REWARD_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Target network Chain ID (11155111 for Ethereum Sepolia testnet, 31337 for local Hardhat node)
VITE_DEFAULT_CHAIN_ID=11155111

# Sepolia RPC URL for frontend read-only blockchain queries and provider fallback
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
