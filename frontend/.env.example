# =====================================================================
# Crowdfunding Protocol Frontend - Environment Variables for Vercel / Production
# =====================================================================
# NOTE: In Vite, all client-exposed environment variables MUST start with "VITE_"

# 1. Deployed CrowdfundingFactory Contract Address on Sepolia
VITE_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# 2. Deployed Funding Token (e.g. Mock USDC) Address on Sepolia
VITE_FUNDING_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# 3. Deployed Reward Token (e.g. Mock GOV) Address on Sepolia
VITE_REWARD_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# 4. Target Network Chain ID (11155111 for Ethereum Sepolia Testnet, 31337 for Local Hardhat)
VITE_DEFAULT_CHAIN_ID=11155111

# 5. Public or Private Sepolia RPC URL (Infura, Alchemy, or public endpoints)
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
